flowchart TB
  user([Navigateur]) -- HTTPS --> cf[CloudFront]
  user -. "Stripe.js (carte)" .-> stripe([Stripe<br/>mode test])
  user -- "wss : suivi en direct" --> ws[API Gateway<br/>WebSocket]
  user -- "connexion" --> cognito[Cognito<br/>admin · magasinier · client]
  subgraph region["Région eu-west-3 (Paris)"]
    s3web[(S3 web<br/>site statique, OAC)]
    s3img[(S3 images<br/>miniatures WebP)]
    api[Lambda api<br/>Function URL]
    ddb[(DynamoDB shop<br/>single-table : produits, stock,<br/>commandes, mouvements, bons)]
    ssm[SSM SecureString<br/>clé secrète Stripe]
    sns{{SNS order-events}}
    qproc[SQS processing + DLQ<br/>ORDER_PAID, STOCK_LOW]
    proc[Lambda processor]
    sfn1[[Step Functions fulfillment<br/>PACKED → SHIPPED → IN_TRANSIT → DELIVERED]]
    sfn2[[Step Functions restock<br/>bon fournisseur → délai → réception]]
    ful[Lambda fulfillment]
    sup[Lambda supplier]
    sweep[Lambda sweeper<br/>réservations, impayés]
    eb[EventBridge<br/>chaque minute]
    sched[EventBridge Scheduler<br/>6 h Paris]
    rep[Lambda reporter<br/>CSV quotidien]
    s3data[(S3 data<br/>CSV, factures, rapports)]
    qmail[SQS mailer] --> mailer[Lambda mailer] --> ses[SES<br/>e-mails, facture, rapport]
    qrt[SQS realtime] --> notif[Lambda notifier] --> ws
    qaud[SQS audit] --> aud[Lambda audit] --> s3audit[(S3 audit<br/>event_type=…/date=…)]
    athena[Athena + Glue<br/>projection de partitions]
    obs[CloudWatch + X-Ray<br/>logs · alarmes · traces]
  end
  cf -- "/* (OAC)" --> s3web
  cf -- "/images/*" --> s3img
  cf -- "/api/* + X-Origin-Verify" --> api
  api -- "transactions conditionnelles" --> ddb
  api -. "PaymentIntent, remboursement" .-> stripe
  api -. lit .-> ssm
  api -- événements --> sns
  sns -- "source=serverless" --> qproc --> proc
  proc --> sfn1 --> ful --> ddb
  proc --> sfn2 --> sup --> ddb
  ful & sup -- "étape suivante" --> sns
  eb --> sweep --> ddb
  sched --> rep --> s3data
  api --> s3data
  sns --> qmail & qrt & qaud
  athena -. requêtes .-> s3audit
  api & proc & ful -.-> obs
