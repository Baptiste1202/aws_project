flowchart TB
  user([Navigateur]) -- HTTPS --> cf[CloudFront<br/>PriceClass_100]
  subgraph region["Région eu-west-3 (Paris)"]
    s3web[(S3 web<br/>site statique)]
    api[Lambda api<br/>Function URL]
    ddb[(DynamoDB<br/>products + orders)]
    sns{{SNS<br/>order-events}}
    q1[SQS processing<br/>délai 5 s + DLQ]
    q2[SQS audit + DLQ]
    proc[Lambda processor]
    aud[Lambda audit]
    s3audit[(S3 audit<br/>events/type=…/date=…)]
    cw[CloudWatch<br/>logs · alarmes · dashboard]
  end
  mail([E-mail de notification<br/>abonnement SNS])
  cf -- "/* (OAC)" --> s3web
  cf -- "/api/* + X-Origin-Verify" --> api
  api -- "transaction stock + commande" --> ddb
  api -- ORDER_CREATED --> sns
  sns -- "filtre source=serverless" --> q1 --> proc
  proc -- "CONFIRMED→PACKED→SHIPPED" --> ddb
  proc -- "ORDER_PACKED / ORDER_SHIPPED" --> sns
  sns -- "tous les événements" --> q2 --> aud --> s3audit
  sns -- "CREATED / SHIPPED" --> mail
  api & proc & aud -.-> cw
