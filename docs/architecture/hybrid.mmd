flowchart TB
  user([Navigateur]) -- HTTPS --> cf[CloudFront hybride<br/>CloudFront Function : routage par méthode]
  user -. "Stripe.js (carte)" .-> stripe([Stripe<br/>mode test])
  user -- "wss : suivi en direct" --> ws[API Gateway<br/>WebSocket]
  user -- "connexion" --> cognito[Cognito]
  subgraph region["Région eu-west-3 (Paris)"]
    s3web[(S3 web<br/>site statique, OAC)]
    read[Lambda hybrid-read<br/>lecture seule]
    subgraph vpc["VPC : partagé avec la solution VM"]
      alb[ALB<br/>X-Origin-Verify + X-Shop: hybrid]
      ec2["EC2 : service shop-hybrid :8081<br/>écritures, purge, worker réappro"]
      rds[(RDS PostgreSQL<br/>base shop_hybrid<br/>fait foi : stock, création)]
    end
    ddb[(DynamoDB hybrid<br/>modèle de lecture projeté<br/>fait foi : statut des commandes)]
    sns{{SNS order-events<br/>source = hybrid}}
    qproj[SQS hybrid-projection] --> proj[Lambda hybrid-projector]
    qproc[SQS hybrid-processing] --> proc[Lambda hybrid-processor]
    sfn[[Step Functions hybrid-fulfillment<br/>PACKED → … → DELIVERED]]
    ful[Lambda hybrid-fulfillment]
    qrest[SQS hybrid-restock<br/>STOCK_LOW, bons]
    sched[EventBridge Scheduler] --> rep[Lambda hybrid-reporter] --> s3data[(S3 data)]
    qmail[SQS mailer] --> mailer[Lambda mailer] --> ses[SES]
    qrt[SQS realtime] --> notif[Lambda notifier] --> ws
    qaud[SQS audit] --> aud[Lambda audit] --> s3audit[(S3 audit)]
    athena[Athena + Glue]
  end
  cf -- "écritures /api/*<br/>(POST, PUT, DELETE)" --> alb --> ec2
  cf -- "GET /api/*" --> read -- lit --> ddb
  cf -- "GET /* (site)" --> s3web
  ec2 -- "transaction SQL" --> rds
  ec2 -- "statut, paiement, retour<br/>(écritures conditionnelles)" --> ddb
  ec2 -. "PaymentIntent, remboursement" .-> stripe
  ec2 -- "événements + stock versionné" --> sns
  sns --> qproj
  proj -- "si version plus récente" --> ddb
  sns -- ORDER_PAID --> qproc
  proc --> sfn --> ful --> ddb
  ful -- "étape suivante" --> sns
  sns --> qrest -- "réappro (RDS)" --> ec2
  rep -. lit .-> ddb
  sns --> qmail & qrt & qaud
  athena -. requêtes .-> s3audit
