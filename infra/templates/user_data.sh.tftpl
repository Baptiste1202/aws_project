#!/bin/bash
# Démarrage d'une instance applicative (Amazon Linux 2023).
# Un service systemd par solution : shop (VM, port 8080) et/ou shop-hybrid (port 8081).
# Version applicative : ${app_version}
set -euxo pipefail

dnf install -y python3-pip
mkdir -p /opt/shop/static
# Environnement Python isolé : pas de conflit avec les paquets RPM du système.
python3 -m venv /opt/shop/venv
/opt/shop/venv/bin/pip install --quiet boto3 psycopg2-binary
%{ if kafka_bootstrap != "" ~}
/opt/shop/venv/bin/pip install --quiet kafka-python
%{ endif ~}

aws s3 cp "s3://${bucket}/vm-app/" /opt/shop/ --recursive --region ${region}
aws s3 cp "s3://${bucket}/web/" /opt/shop/static/ --recursive --region ${region}
%{ for s in services ~}

cat > /etc/${s.unit}.env <<'EOF'
AWS_REGION=${region}
# boto3 ne lit que AWS_DEFAULT_REGION pour les clients créés sans région (DynamoDB, S3).
AWS_DEFAULT_REGION=${region}
SHOP_SOURCE=${s.source}
PORT=${s.port}
STATIC_DIR=/opt/shop/static
PRODUCTS_FILE=/opt/shop/products.json
DB_HOST=${db_host}
DB_NAME=${s.db_name}
DB_USER=${db_user}
DB_PASSWORD_PARAM=${db_password_param}
TOPIC_ARN=${topic_arn}
QUEUE_URL=${s.queue_url}
AUTH_ISSUER=${auth_issuer}
AUTH_CLIENT_ID=${auth_client_id}
DATA_BUCKET=${data_bucket}
IMAGES_BUCKET=${images_bucket}
IMAGES_URL=/images
REALTIME_URL=${realtime_url}
# Paiement Stripe : nom du paramètre SSM de la clé secrète (jamais la clé elle-même).
%{ if stripe_secret_param != "" ~}
STRIPE_PUBLISHABLE_KEY=${stripe_publishable_key}
STRIPE_SECRET_PARAM=${stripe_secret_param}
%{ endif ~}
STATUS_TABLE=${s.status_table}
%{ if s.source == "vm" ~}
KAFKA_BOOTSTRAP=${kafka_bootstrap}
KAFKA_QUEUE_URL=${kafka_queue_url}
%{ endif ~}
EOF

cat > /etc/systemd/system/${s.unit}.service <<'EOF'
[Unit]
Description=Boutique en ligne (solution ${s.source})
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/${s.unit}.env
ExecStart=/opt/shop/venv/bin/python /opt/shop/app.py
Restart=always
RestartSec=5
DynamicUser=yes

[Install]
WantedBy=multi-user.target
EOF
%{ endfor ~}

systemctl daemon-reload
%{ for s in services ~}
systemctl enable --now ${s.unit}.service
%{ endfor ~}
