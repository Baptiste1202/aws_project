          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(sum(total), 0) AS ca FROM orders WHERE status IN ('CONFIRMED','PACKED','SHIPPED','IN_TRANSIT','DELIVERED','RETURN_REQUESTED','RETURNED') AND COALESCE(payment->>'status', '') <> 'refunded' AND created_at::timestamptz >= date_trunc('day', now())"
