        "uid": "${base}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${base}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS commandes FROM orders WHERE status IN ('CONFIRMED','PACKED','SHIPPED','IN_TRANSIT','DELIVERED','RETURN_REQUESTED','RETURNED') AND COALESCE(payment->>'status', '') <> 'refunded' AND created_at::timestamptz >= date_trunc('day', now())"
